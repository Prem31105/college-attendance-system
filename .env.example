# ==============================================================================
# AUTONOMOUS COLLEGE ATTENDANCE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your local or production environment.
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://attendance_admin:attendance_secure_pass@localhost:5432/college_attendance?schema=public

# Redis Configuration (For Caching, Throttling & Fast Nonce Storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Cryptography
# Generate secure random 64-char strings for secrets in production
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_byte_string_for_access_tokens
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_byte_string_for_refresh_tokens
JWT_REFRESH_EXPIRATION=7d
QR_HMAC_SECRET=replace_with_a_secure_random_64_byte_string_for_qr_signature

# Attendance Security Configuration (Defaults from Master Specification)
QR_REFRESH_INTERVAL_SECONDS=15
QR_TOKEN_VALIDITY_SECONDS=30
DEFAULT_GEOFENCE_RADIUS_METERS=75
MAX_ACCEPTED_GPS_ACCURACY_METERS=20

# Platform Device Integrity (Optional / Fallback Enabled by Default)
ENABLE_STRICT_DEVICE_INTEGRITY=false
GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME=com.college.attendance
APPLE_APP_ATTEST_APP_ID=TEAMID.com.college.attendance

# React Web Dashboard (Vite Frontend)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_BASE_URL=ws://localhost:3000
